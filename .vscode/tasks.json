{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "watch",
      "isBackground": true,
      "label": "npm: watch",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": {
        "owner": "esbuild",
        "pattern": { "regexp": "^\\s*$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*watching.*$",
          "endsPattern": "^.*build finished.*$"
        }
      }
    }
  ]
}
