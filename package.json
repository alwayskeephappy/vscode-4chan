{
  "name": "vscode-4chan",
  "displayName": "vscode-4chan",
  "description": "在 VSCode 侧边栏浏览 4chan（只读），含免费/AI 帖子翻译",
  "version": "1.0.7",
  "icon": "media/icon-128.png",
  "publisher": "utopiaExist",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/alwayskeephappy/4chan-VSCode.git"
  },
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "4chan-container",
          "title": "vscode-4chan",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "4chan-container": [
        {
          "type": "webview",
          "id": "4chan.browser",
          "name": "4chan",
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "4chan.openBrowser",
        "title": "4chan: 打开浏览器"
      },
      {
        "command": "4chan.translate.menu",
        "title": "4chan: 翻译设置"
      }
    ],
    "keybindings": [
      {
        "command": "4chan.openBrowser",
        "key": "ctrl+shift+alt+4",
        "mac": "cmd+shift+alt+4"
      }
    ],
    "configuration": {
      "title": "4chan 翻译",
      "properties": {
        "vscode-4chan.translate.provider": {
          "type": "string",
          "enum": [
            "free-google",
            "free-mymemory",
            "openai",
            "deepseek",
            "glm",
            "qwen"
          ],
          "enumDescriptions": [
            "Google 翻译（免费·非官方）",
            "MyMemory（免费·有额度）",
            "OpenAI",
            "DeepSeek",
            "智谱 GLM",
            "通义千问"
          ],
          "default": "free-google",
          "markdownDescription": "选择翻译提供商。AI 类需先在「高级设置」中配好 API Key 后才会出现在引擎列表。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.config.mjs --production",
    "watch": "node esbuild.config.mjs --watch",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.20.2",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
